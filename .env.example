# .env.example - 내 PC 용 .env 의 본보기
#   copy .env.example .env  로 복사한 뒤 값을 바꾼다. (.env 는 .gitignore 에 있어 GitHub 에 올라가지 않는다)
#   docker compose 는 같은 폴더의 .env 를 자동으로 읽는다.

# Docker Hub 사용자 이름 → 이미지 이름이 <이 값>/msa-user-service 처럼 된다 (3장)
DOCKERHUB_USERNAME=my-dockerhub-id

# 내 PC 에서는 비워 둬도 된다 (docker-compose.yml 의 기본값을 쓴다)
# DB_PASSWORD=
# JWT_SECRET=
